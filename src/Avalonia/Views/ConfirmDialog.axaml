<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WindowsAppProtector.Views.ConfirmDialog"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFontFamily}">

    <StackPanel Spacing="{StaticResource Space4}"
                Margin="24,20,24,20">
        <TextBlock x:Name="DialogTitleText"
                   Classes="section-title"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="DialogMessageText"
                   Classes="body"
                   Foreground="{DynamicResource InkMutedBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="{StaticResource Space2}"
                    Margin="0,8,0,0">
            <Button x:Name="CancelButton"
                    Content="취소"
                    MinWidth="84"
                    IsCancel="True"
                    Click="OnCancelClick" />

            <Button x:Name="ConfirmButton"
                    Classes="Danger"
                    Content="제거"
                    MinWidth="96"
                    IsDefault="True"
                    Click="OnConfirmClick" />
        </StackPanel>
    </StackPanel>
</Window>
